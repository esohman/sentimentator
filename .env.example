SECRET_KEY=replace-with-a-long-random-secret
EMOMAP_STUDY_KEY=emomap-pilot
EMOMAP_STUDY_VERSION=1
ADMIN_USERNAMES=admin
SESSION_COOKIE_SECURE=0

